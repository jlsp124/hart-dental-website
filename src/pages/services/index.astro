---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ClosingCta from "../../components/ClosingCta.astro";
import ServiceIndex from "../../components/ServiceIndex.astro";
import { absoluteUrl } from "../../data/site";

const title = "Dental Services | Hart Dental";
const description = "Explore dental services at Hart Dental in Prince George, including preventive, restorative, cosmetic, emergency, implant, orthodontic and comfort-focused care.";
const schema = {
  "@type": "CollectionPage",
  "@id": `${absoluteUrl("/services")}#collection`,
  name: "Dental Services",
  url: absoluteUrl("/services"),
  isPartOf: { "@id": "https://www.hartdental.ca/#website" }
};
---

<BaseLayout title={title} description={description} canonicalPath="/services" schema={schema}>
  <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Services" }]} />
  <section class="page-hero services-hero paper-section">
    <div class="page-hero-grid shell">
      <div data-reveal>
        <p class="eyebrow">Dental services</p>
        <h1>Care for the smile you live in.</h1>
      </div>
      <div class="page-hero-copy" data-reveal>
        <p>Dental needs change over time. Browse Hart Dental’s current services by the role they can play: preventing problems, restoring function or making care more comfortable.</p>
        <p><a class="text-link" href="/contact-us">Not sure where to start? Contact us <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section class="section-pad ink-section">
    <div class="shell">
      <ServiceIndex headingLevel="h2" />
    </div>
  </section>

  <section class="section-pad white-section">
    <div class="split-section shell">
      <div class="split-copy" data-reveal>
        <p class="eyebrow">Planning your care</p>
        <h2>The right option begins with an assessment.</h2>
      </div>
      <div class="split-copy" data-reveal>
        <p>These pages explain general service categories and common questions. They cannot determine which treatment is right for you. A dentist will review your health, examine the area and discuss appropriate options, alternatives and costs before care begins.</p>
        <a class="button" href="/become-patient">Become a patient</a>
      </div>
    </div>
  </section>

  <ClosingCta title="Have a question about a service?" copy="Call the team or send a short appointment request. Please phone for urgent dental concerns." />
</BaseLayout>
