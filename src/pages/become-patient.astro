---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ClosingCta from "../components/ClosingCta.astro";
import hero from "../assets/hart-team-hero.webp";
import { SITE, sitePath } from "../data/site";

const title = "Become a Patient | Hart Dental";
const description = "Hart Dental welcomes new patients in Prince George. Learn what to bring, what to expect and how to request a first appointment.";
---

<BaseLayout title={title} description={description} canonicalPath="/become-patient">
  <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Become a Patient" }]} />
  <section class="page-hero page-hero-ink">
    <div class="page-hero-grid shell">
      <div data-reveal>
        <p class="eyebrow eyebrow-light">New patients welcome</p>
        <h1>A first visit that starts with you.</h1>
      </div>
      <div class="page-hero-copy" data-reveal>
        <p>New to Hart Dental? Tell the team what brings you in, what you are concerned about and what would make the visit more comfortable.</p>
        <a class="button" href={sitePath("/contact-us#request")}>Request a first appointment</a>
      </div>
    </div>
  </section>

  <section class="white-section">
    <div class="split-section shell section-pad">
      <div class="split-media split-media-landscape" data-reveal>
        <Image src={hero} alt="The Hart Dental team welcoming patients in Prince George" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" quality={84} />
      </div>
      <div class="split-copy" data-reveal>
        <p class="eyebrow">Before you arrive</p>
        <h2>A little context helps.</h2>
        <p>When the office confirms your visit, ask what records or forms are needed. If available, bring your identification, dental-benefit information, a current medication list and details of your previous dental office.</p>
        <p>Let the team know about accessibility needs or dental anxiety in advance. Please call rather than use the web form for urgent or detailed health concerns.</p>
        <a class="text-link" href={SITE.phoneHref}>Call {SITE.phoneDisplay} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section-pad paper-section">
    <div class="shell">
      <header class="section-intro" data-reveal>
        <p class="eyebrow">A simple path in</p>
        <h2>What to expect.</h2>
      </header>
      <div class="service-index service-index-compact">
        <section class="service-group" data-reveal>
          <div class="service-group-heading"><span>01</span><h3>Connect</h3></div>
          <p>Request a visit online or call. An online request is not a confirmed appointment; the team will follow up.</p>
        </section>
        <section class="service-group" data-reveal>
          <div class="service-group-heading"><span>02</span><h3>Assess</h3></div>
          <p>Your first appointment is planned around the reason for your visit. The dentist may recommend an examination and appropriate records.</p>
        </section>
        <section class="service-group" data-reveal>
          <div class="service-group-heading"><span>03</span><h3>Plan</h3></div>
          <p>After reviewing the findings, the team can explain next steps, alternatives, timing and estimated fees.</p>
        </section>
      </div>
    </div>
  </section>

  <section class="section-pad white-section">
    <div class="shell prose">
      <p class="eyebrow">Common first-visit questions</p>
      <h2>Things worth knowing.</h2>
      <h3>Can I use dental benefits?</h3>
      <p>Bring your current plan details. Hart Dental can help with available estimates and claims processes, but coverage and reimbursement are determined by your plan provider.</p>
      <h3>What if I am nervous?</h3>
      <p>Tell the team when you book. Dental anxiety is common, and knowing in advance helps the office plan the conversation and discuss appropriate comfort options.</p>
      <h3>What if I have an urgent problem?</h3>
      <p>Call the office at <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>. A phone conversation is faster and lets the team ask the right questions. Seek emergency medical care for trouble breathing, severe swelling, uncontrolled bleeding or serious injury.</p>
    </div>
  </section>

  <ClosingCta eyebrow="Ready when you are" title="Your first step can be a short one." copy="Send a simple appointment request or call the Hart Dental office. The team will confirm availability and next steps." />
</BaseLayout>
