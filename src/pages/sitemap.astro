---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { PRIMARY_NAV, sitePath } from "../data/site";
import { serviceGroups } from "../data/services";

const title = "Sitemap | Hart Dental";
const description = "Browse every primary page and dental service on the Hart Dental website.";
---

<BaseLayout title={title} description={description} canonicalPath="/sitemap">
  <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Sitemap" }]} />
  <section class="page-hero paper-section">
    <div class="shell">
      <p class="eyebrow">All pages</p>
      <h1>Sitemap.</h1>
    </div>
  </section>
  <section class="section-pad white-section">
    <div class="sitemap-grid shell">
      <section>
        <h2>Hart Dental</h2>
        <ul>
          <li><a href={sitePath("/")}>Home</a></li>
          {PRIMARY_NAV.map((item) => <li><a href={sitePath(item.href)}>{item.label}</a></li>)}
          <li><a href={sitePath("/privacy-policy")}>Privacy Policy</a></li>
        </ul>
      </section>
      {serviceGroups.map((group) => (
        <section>
          <h2>{group.category} services</h2>
          <ul>{group.services.map((service) => <li><a href={sitePath(`/services/${service.slug}`)}>{service.navTitle}</a></li>)}</ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
