---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm.astro";
import { HOURS, SITE, addressInline, absoluteUrl } from "../data/site";

const title = "Contact Us | Hart Dental";
const description = "Contact Hart Dental at 3644 Austin Road W in Prince George, BC. Call 250-962-5351, get directions or request an appointment.";
const schema = {
  "@type": "ContactPage",
  "@id": `${absoluteUrl("/contact-us")}#contact`,
  name: "Contact Hart Dental",
  url: absoluteUrl("/contact-us"),
  mainEntity: { "@id": `${SITE.origin}/#dentist` }
};
---

<BaseLayout title={title} description={description} canonicalPath="/contact-us" schema={schema}>
  <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Contact Us" }]} />
  <section class="page-hero paper-section">
    <div class="page-hero-grid shell">
      <div data-reveal>
        <p class="eyebrow">Contact Hart Dental</p>
        <h1>Contact Hart Dental.</h1>
      </div>
      <div class="page-hero-copy" data-reveal>
        <p>Call for urgent dental concerns. For routine requests, send the short form below and the Hart Dental team will follow up to confirm availability.</p>
      </div>
    </div>
  </section>

  <section class="section-pad paper-section" id="request">
    <div class="contact-grid shell">
      <aside class="contact-details" data-reveal>
        <p class="eyebrow">Reach the office</p>
        <h2>Hart Dental</h2>
        <ul class="contact-list">
          <li><small>Phone</small><a href={SITE.phoneHref}>{SITE.phoneDisplay}</a></li>
          <li><small>Email</small><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><small>Visit</small><address>{addressInline()}</address><a class="text-link" href={SITE.directionsUrl}>Get directions <span aria-hidden="true">→</span></a></li>
        </ul>
        <h3 style="margin-top: 38px">Office hours</h3>
        <dl class="hours-list">
          {HOURS.map((item) => <><dt>{item.shortDay}</dt><dd>{item.display}</dd></>)}
        </dl>
      </aside>

      <div class="appointment-panel" data-reveal>
        <p class="eyebrow">Appointment request</p>
        <h2>Tell us how to reach you.</h2>
        <p>The team will contact you to confirm an appointment. For urgent concerns, call <a href={SITE.phoneHref}>{SITE.phoneDisplay}</a>.</p>
        <ContactForm />
      </div>
    </div>
  </section>

</BaseLayout>

