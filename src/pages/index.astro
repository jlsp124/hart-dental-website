---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ClosingCta from "../components/ClosingCta.astro";
import SectionIntro from "../components/SectionIntro.astro";
import ServiceIndex from "../components/ServiceIndex.astro";
import { dentists } from "../data/team";
import { SITE, sitePath } from "../data/site";
import hero from "../assets/hart-team-hero.webp";

const title = "Prince George Dentist | Hart Dental";
const description = "Hart Dental in Prince George offers family, general and cosmetic dentistry in a friendly environment. Meet our team, explore services or request an appointment.";
---

<BaseLayout title={title} description={description} canonicalPath="/" bodyClass="home-page">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-media">
      <Image src={hero} alt="The Hart Dental team outside the Prince George clinic" widths={[768, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" quality={82} />
    </div>
    <div class="home-hero-content shell">
      <div class="home-hero-copy" data-reveal>
        <p class="eyebrow eyebrow-light">Hart Dental · Prince George, BC</p>
        <h1 id="home-title">Family dental care<br />in Prince George.</h1>
        <p class="hero-lede">From regular checkups to restorative and cosmetic care, our team is here to help you feel comfortable at every visit.</p>
        <div class="hero-actions">
          <a class="button" href={sitePath("/contact-us#request")}>Request an appointment</a>
          <a class="hero-services-link" href={sitePath("/services")}>Explore our services <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="hero-aside">
        <strong>New patients welcome</strong>
        <p>3644 Austin Road W<br />Prince George, BC</p>
      </aside>
    </div>
  </section>

  <nav class="home-shortcuts shell" aria-label="Patient information">
    <a href={sitePath("/become-patient")}><span>Become a patient</span><small>What to expect at your first visit</small><i aria-hidden="true">↗</i></a>
    <a href={sitePath("/hart-dental-reviews")}><span>Patient reviews</span><small>Read about patients’ experiences</small><i aria-hidden="true">↗</i></a>
    <a href={sitePath("/contact-us")}><span>Visit the clinic</span><small>Hours, directions and contact details</small><i aria-hidden="true">↗</i></a>
  </nav>

  <section class="section-pad ink-section">
    <div class="shell">
      <SectionIntro eyebrow="Dental services" title="Care for your whole family." copy="Explore preventive, restorative and cosmetic dentistry, with care for children and support for urgent dental concerns." />
      <ServiceIndex />
    </div>
  </section>

  <section class="section-pad white-section">
    <div class="shell">
      <SectionIntro eyebrow="Your dentists" title="Meet Dr. Pahal and Dr. Walker." copy="Get to know your dentists and the team supporting your care." />
      <div class="dentist-strip">
        {dentists.map((person) => (
          <a class="person-card" href={sitePath(`/our-team#${person.name.toLowerCase().replace(/[^a-z]+/g, "-").replace(/^-|-$/g, "")}`)} data-reveal>
            <figure>
              <Image src={person.image} alt={person.alt} widths={[360, 560, 720]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" quality={84} />
              <figcaption><strong>{person.name}</strong><small>{person.role}</small></figcaption>
            </figure>
          </a>
        ))}
      </div>
      <p style="margin-top: 38px"><a class="button button-outline" href={sitePath("/our-team")}>Meet the full team</a></p>
    </div>
  </section>

  <section class="section-pad paper-section">
    <div class="split-section shell">
      <div class="split-media split-media-landscape" data-reveal>
        <Image src={hero} alt="Members of the Hart Dental team in Prince George" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" quality={83} />
        <div class="image-caption"><span>The Hart Dental team</span><span>Prince George, BC</span></div>
      </div>
      <div class="split-copy" data-reveal>
        <p class="eyebrow">Your first visit</p>
        <h2>New to Hart Dental?</h2>
        <p>We welcome new patients. Find out what to bring, how to request an appointment and what to expect when you arrive.</p>
        <a class="button" href={sitePath("/become-patient")}>What new patients can expect</a>
      </div>
    </div>
  </section>

  <section class="section-pad white-section">
    <div class="shell">
      <div class="review-feature" data-reveal>
        <blockquote>
          “Everyone is so warm and welcoming. I felt 100% taken care of.”
        </blockquote>
      </div>
      <div style="margin-top: 28px; display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap">
        <p style="max-width: 580px; color: var(--muted)">Read more patient reviews or share your own experience.</p>
        <a class="text-link" href={sitePath("/hart-dental-reviews")}>Read patient reviews <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="paper-section">
    <div class="visit-section shell section-pad">
      <div class="split-copy" data-reveal>
        <p class="eyebrow">Find us in the Hart</p>
        <h2>Visit us on Austin Road.</h2>
        <p style="color: rgba(16,25,22,.76)">Hart Dental is located at 3644 Austin Road W in Prince George. Call ahead for urgent concerns so the team can guide you to the right next step.</p>
        <div class="hero-actions">
          <a class="button button-light" href={SITE.directionsUrl}>Get directions</a>
          <a class="button button-outline" href={SITE.phoneHref}>Call {SITE.phoneDisplay}</a>
        </div>
      </div>
      <div class="visit-details" data-reveal>
        <p class="eyebrow">Planning your visit</p>
        <h3>3644 Austin Road W</h3>
        <p>Prince George, BC<br />V2K 2H6</p>
        <a class="text-link" href={sitePath("/contact-us")}>View office hours <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <ClosingCta />
</BaseLayout>
