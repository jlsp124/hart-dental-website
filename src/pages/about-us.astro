---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ClosingCta from "../components/ClosingCta.astro";
import exterior from "../assets/office-exterior.jpg";
import hero from "../assets/hart-team-hero.webp";
import { sitePath } from "../data/site";

const title = "About Us | Hart Dental";
const description = "Learn about Hart Dental, a community-focused dental office serving Prince George from 3644 Austin Road W.";
---

<BaseLayout title={title} description={description} canonicalPath="/about-us">
  <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "About Us" }]} />
  <section class="page-hero paper-section">
    <div class="page-hero-grid shell">
      <div data-reveal>
        <p class="eyebrow">About Hart Dental</p>
        <h1>A neighbourhood practice, shaped by its people.</h1>
      </div>
      <div class="page-hero-copy" data-reveal>
        <p>Hart Dental is based in the Hart neighbourhood of Prince George. The practice brings preventive, restorative and comfort-focused care together in one familiar office.</p>
      </div>
    </div>
  </section>

  <section class="white-section">
    <div class="split-section shell section-pad">
      <div class="split-media split-media-landscape" data-reveal>
        <Image src={exterior} alt="Hart Dental clinic exterior on Austin Road W" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" quality={84} />
        <div class="image-caption"><span>3644 Austin Road W</span><span>Prince George, BC</span></div>
      </div>
      <div class="split-copy" data-reveal>
        <p class="eyebrow">Rooted here</p>
        <h2>Care belongs in the community.</h2>
        <p>A dental office is more than equipment and treatment rooms. It is a place where children have first visits, people bring questions they have been putting off, and families return over time. Hart Dental’s current team includes dentists and staff with strong Prince George connections.</p>
        <p>The approach is straightforward: listen first, explain the findings, and build a plan around the patient in front of you.</p>
        <a class="button" href={sitePath("/our-team")}>Meet the team</a>
      </div>
    </div>
  </section>

  <section class="section-pad ink-section">
    <div class="shell">
      <header class="section-intro" data-reveal>
        <p class="eyebrow eyebrow-light">What guides the experience</p>
        <h2>Clear conversations are part of good care.</h2>
      </header>
      <div class="service-index">
        <section class="service-group" data-reveal>
          <div class="service-group-heading"><span>01</span><h3>Listen</h3></div>
          <p style="color: rgba(255,255,255,.65)">Your comfort, goals and questions help frame the visit.</p>
        </section>
        <section class="service-group" data-reveal>
          <div class="service-group-heading"><span>02</span><h3>Explain</h3></div>
          <p style="color: rgba(255,255,255,.65)">Findings, options and next steps should be understandable.</p>
        </section>
        <section class="service-group" data-reveal>
          <div class="service-group-heading"><span>03</span><h3>Plan</h3></div>
          <p style="color: rgba(255,255,255,.65)">Recommendations are based on an examination and your circumstances.</p>
        </section>
      </div>
    </div>
  </section>

  <section class="paper-section">
    <div class="split-section shell section-pad">
      <div class="split-copy" data-reveal>
        <p class="eyebrow">A practical visit</p>
        <h2>Designed to feel calm, not clinical.</h2>
        <p>The office presents a bright, approachable setting and a team that supports patients through scheduling, hygiene, chairside care and follow-up.</p>
        <p>Questions about insurance, payment or the timing of treatment are best discussed with the office directly. Coverage varies by plan, and an estimate is not a guarantee of reimbursement.</p>
        <a class="text-link" href={sitePath("/contact-us")}>Contact Hart Dental <span aria-hidden="true">→</span></a>
      </div>
      <div class="split-media split-media-landscape" data-reveal>
        <Image src={hero} alt="The current Hart Dental team in Prince George" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" quality={84} />
      </div>
    </div>
  </section>

  <ClosingCta />
</BaseLayout>
