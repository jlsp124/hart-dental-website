---
import { PRIMARY_NAV, SITE, sitePath } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = (base && Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname).replace(/\/$/, "") || "/";
const isActive = (href: string) => href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header" data-header>
  <div class="header-shell">
    <a class="wordmark" href={sitePath("/")} aria-label="Hart Dental home">
      <img src={sitePath("/hart-dental-logo.png")} alt="" width="1152" height="267" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-nav-toggle>
      <span>Menu</span>
      <span class="nav-toggle-lines" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label="Primary navigation" data-nav>
      <ul>
        {PRIMARY_NAV.map((item) => (
          <li><a href={sitePath(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <div class="nav-actions">
        <a class="nav-phone" href={SITE.phoneHref}>{SITE.phoneDisplay}</a>
        <a class="button button-small" href={sitePath("/contact-us#request")}>Request an appointment</a>
      </div>
    </nav>
  </div>
</header>
