---
type Crumb = { name: string; href?: string };
import { sitePath } from "../data/site";
interface Props { items: Crumb[] }
const { items } = Astro.props;
---

<nav class="breadcrumbs shell" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index !== items.length - 1 ? <a href={sitePath(item.href)}>{item.name}</a> : <span aria-current={index === items.length - 1 ? "page" : undefined}>{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>
