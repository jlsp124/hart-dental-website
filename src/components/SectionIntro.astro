---
interface Props {
  eyebrow?: string;
  title: string;
  copy?: string;
  align?: "left" | "center";
}
const { eyebrow, title, copy, align = "left" } = Astro.props;
---

<header class:list={["section-intro", align === "center" && "section-intro-center"]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {copy && <p>{copy}</p>}
</header>

