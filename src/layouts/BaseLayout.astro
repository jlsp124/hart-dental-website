---
import "@fontsource-variable/manrope";
import "@fontsource-variable/newsreader";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { HOURS, SITE, absoluteUrl, addressInline } from "../data/site";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = "/og-hart-dental.jpg",
  schema,
  bodyClass = ""
} = Astro.props;

const preview = (import.meta.env.PUBLIC_SITE_MODE || "preview") !== "production";
const canonical = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(image);
const pageId = `${canonical}#webpage`;

const baseGraph: Record<string, unknown>[] = [
  {
    "@type": ["Dentist", "LocalBusiness"],
    "@id": `${SITE.origin}/#dentist`,
    name: SITE.name,
    alternateName: SITE.alternateName,
    url: SITE.origin,
    telephone: "+1-250-962-5351",
    email: SITE.email,
    image: imageUrl,
    logo: absoluteUrl("/hart-dental-logo.png"),
    priceRange: "$$",
    address: {
      "@type": "PostalAddress",
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.locality,
      addressRegion: SITE.address.region,
      postalCode: SITE.address.postalCode,
      addressCountry: "CA"
    },
    geo: { "@type": "GeoCoordinates", latitude: SITE.geo.latitude, longitude: SITE.geo.longitude },
    hasMap: SITE.directionsUrl,
    sameAs: [SITE.facebookUrl, SITE.instagramUrl],
    openingHoursSpecification: HOURS.filter((item) => item.opens && item.closes).map((item) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: `https://schema.org/${item.day}`,
      opens: item.opens,
      closes: item.closes
    }))
  },
  {
    "@type": "WebSite",
    "@id": `${SITE.origin}/#website`,
    url: SITE.origin,
    name: SITE.name,
    publisher: { "@id": `${SITE.origin}/#dentist` },
    inLanguage: "en-CA"
  },
  {
    "@type": "WebPage",
    "@id": pageId,
    url: canonical,
    name: title,
    description,
    isPartOf: { "@id": `${SITE.origin}/#website` },
    about: { "@id": `${SITE.origin}/#dentist` },
    inLanguage: "en-CA"
  }
];

const additions = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = { "@context": "https://schema.org", "@graph": [...baseGraph, ...additions] };
---

<!doctype html>
<html lang="en-CA" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={preview ? "noindex, nofollow, noarchive" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#18332d" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/hart-dental-logo.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={`Hart Dental at ${addressInline()}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <script is:inline>document.documentElement.classList.remove("no-js");</script>
  </head>
  <body class={bodyClass}>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
