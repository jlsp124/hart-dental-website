{
  "name": "hart-dental-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "build:github-pages": "astro check && astro build",
    "preview": "wrangler pages dev dist",
    "test": "npm run test:static && npm run test:e2e",
    "test:static": "node scripts/seo-check.mjs",
    "test:e2e": "playwright test",
    "qa": "npm run build && npm run test",
    "deploy:cloudflare": "wrangler pages deploy dist --project-name hart-dental-website --branch main"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "latest",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "1.62.1",
    "@types/node": "latest",
    "sharp": "latest",
    "typescript": "latest",
    "wrangler": "4.128.0"
  }
}
