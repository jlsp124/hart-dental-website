# Browser-visible Turnstile site key. Use a real Hart-specific widget in production.
PUBLIC_TURNSTILE_SITE_KEY=

# Build mode: preview keeps noindex/robots blocking; production enables indexing.
PUBLIC_SITE_MODE=preview

# Pages Function variables/secrets are configured in Cloudflare, not committed here:
# FORM_MODE=preview|production
# FORM_RECIPIENT=private delivery mailbox
# TURNSTILE_SECRET=secret key
# RESEND_API_KEY=optional email provider key
# FORM_FROM=verified sender address
